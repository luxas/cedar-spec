(set-logic HO_ALL)
(declare-sort E 0)
(declare-fun anc (E) (Set E))
(declare-const S (Set E))
(declare-const a E)(declare-const b E)(declare-const c E)
(assert (set.member a S))(assert (set.member b S))(assert (set.member c S))
(assert (distinct a b c))
(assert (= (set.filter (lambda ((x E)) (not (set.member x (anc x)))) S) S))
(assert (= (set.filter (lambda ((x E)) (= (set.filter (lambda ((y E)) (=> (set.member y (anc x)) (set.subset (anc y) (anc x)))) S) S)) S) S))
(assert (set.member b (anc a)))(assert (set.member c (anc b)))(assert (set.member a (anc c)))
(check-sat)
