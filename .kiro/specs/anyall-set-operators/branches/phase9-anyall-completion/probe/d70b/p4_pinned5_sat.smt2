(set-logic HO_ALL)
(declare-sort E 0)
(declare-fun anc (E) (Set E))
(declare-const S (Set E))
(declare-const m0 E)(declare-const m1 E)(declare-const m2 E)(declare-const m3 E)(declare-const m4 E)
(assert (set.member m0 S))(assert (set.member m1 S))(assert (set.member m2 S))(assert (set.member m3 S))(assert (set.member m4 S))
(assert (distinct m0 m1 m2 m3 m4))
(assert (= (set.filter (lambda ((x E)) (not (set.member x (anc x)))) S) S))
(assert (= (set.filter (lambda ((x E)) (= (set.filter (lambda ((y E)) (=> (set.member y (anc x)) (set.subset (anc y) (anc x)))) S) S)) S) S))
(check-sat)
